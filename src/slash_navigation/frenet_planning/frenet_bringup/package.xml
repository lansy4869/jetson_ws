<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>frenet_bringup</name>
  <version>0.0.1</version>
  <description>Bringup launch package for the Frenet racing stack.</description>
  <maintainer email="yuanwentian@icloud.com">jetson</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>frenet_runtime</exec_depend>
  <exec_depend>reactive_racing</exec_depend>
  <exec_depend>frenet_local_planner</exec_depend>
  <exec_depend>frenet_mpc</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
